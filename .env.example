# Hugging Face Hub write/read token (keep secret; never commit .env)
HF_TOKEN=

# Target Hugging Face Hub repository ID (e.g. your-username/intent-injection-guard)
HF_REPO_ID=

# Path to custom labeled dataset CSV containing columns: text,label (labels 0, 1, 2)
CUSTOM_DATA_PATH=data/support_intents.csv
